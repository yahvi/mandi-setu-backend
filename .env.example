PORT=5000
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mandisetu
JWT_SECRET=change-this-to-a-long-random-string

# Sign up at https://dashboard.razorpay.com (free) and use your TEST mode keys here.
# Test mode never charges real money and needs no business verification to start.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional. Without this, requirement-parsing and scheme-recommendation fall back
# to a simpler keyword-based extractor (still real, just less flexible with phrasing).
OPENAI_API_KEY=
